# Database
DATABASE_URL=postgresql://screenkonect:screenkonect@localhost:5432/screenkonect

# Redis
REDIS_URL=redis://localhost:6380

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=sk-dev-access-secret-key-change-in-production-32ch
JWT_REFRESH_SECRET=sk-dev-refresh-secret-key-change-in-production-32

# Server
PORT=3000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Gateway single-port (avoid chael SIEM 8080 conflict)
SK_GATEWAY_PORT=8090
SK_POSTGRES_PORT=5432
SK_REDIS_PORT=6380

# Public URL for join links (tailscale funnel). If empty, uses request host.
# Set to your funnel URL e.g. https://desktop-a780de3.tail68a7aa.ts.net
PUBLIC_URL=http://localhost:8090

# Observability
LOG_LEVEL=info
