# Database
DATABASE_URL=postgresql://screenkonect:screenkonect@localhost:5432/screenkonect

# Redis
REDIS_URL=redis://localhost:6380

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-here

# Server
PORT=4000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_ENDPOINT=

# TURN Server (optional)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Docker Compose port overrides ---
# docker compose reads these from the .env file in the project root.
# Only set these if the default port is already used by another stack
# (e.g. your SIEM). Example: SK_AUTH_PORT=4010
SK_POSTGRES_PORT=5432
SK_REDIS_PORT=6380
SK_AUTH_PORT=4000
SK_SESSION_PORT=4001
SK_SIGNALING_PORT=4002
SK_AUDIT_PORT=4003
SK_DEVICE_PORT=4004
SK_DASHBOARD_PORT=5173
SK_CONSENT_PORT=5174
