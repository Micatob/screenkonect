{
  "name": "ScreenKonect",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8080, 5173, 5174, 4000, 4001, 4002, 4003, 4004, 5432, 6380],
  "portsAttributes": {
    "8080": {
      "label": "Gateway - Single Port (Share This)",
      "visibility": "public",
      "onAutoForward": "notify"
    },
    "5173": { "label": "Dashboard", "visibility": "private" },
    "5174": { "label": "Consent UI", "visibility": "private" }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "docker compose -f deploy/docker-compose.yaml up -d --build && sleep 10 && docker compose -f deploy/docker-compose.yaml ps",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "HOW-IT-WORKS.md"]
    },
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
