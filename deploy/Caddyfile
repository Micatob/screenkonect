# Shared site config: API + static frontends + downloads.
# Served plain on :80 and (optionally) with automatic HTTPS on your domain.
(common) {
	# Health check endpoint (for monitoring / Tailscale funnel verification)
	handle /healthz {
		respond "ok" 200
	}

	# 1. WebSocket signaling - exact path match only
	handle /ws/signaling {
		reverse_proxy signaling:4002
	}

	# 2. APIs - must be before frontend
	handle /v1/auth/* {
		reverse_proxy auth:4000
	}
	handle /v1/sessions/* {
		reverse_proxy session:4001
	}
	handle /v1/sessions {
		reverse_proxy session:4001
	}
	handle /v1/devices/* {
		reverse_proxy device:4004
	}
	handle /v1/devices {
		reverse_proxy device:4004
	}
	handle /v1/audit/* {
		reverse_proxy audit:4003
	}
	handle /v1/* {
		reverse_proxy auth:4000
	}

	# 3. Client consent UI - prebuilt static files (vite base '/join/').
	# No dev server, no HMR, no cookies: assets live under /join/* by construction.
	handle /join/* {
		root * /srv/consent
		uri strip_prefix /join
		try_files {path} /index.html
		file_server
	}
	handle /join {
		redir /join/ 308
	}

	# 4. Agent download - direct exe from VPS, no GitHub login for clients
	handle /downloads/* {
		root * /srv/downloads
		file_server
	}

	# 5. Technician dashboard - prebuilt static files with SPA fallback
	# (/login, /session/:id all serve index.html; JS/CSS under /assets/*)
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP (local use, VPS IP use, Tailscale funnel feeds into this)
:80 {
	import common
}

# ----- Public domain with automatic HTTPS (optional, recommended for VPS) -----
# 1. Create a DNS A record: your-domain -> your VPS public IP.
# 2. Uncomment the 3 lines below and put your real domain in place of
#    sk-join.example.com (in this file AND in .env PUBLIC_URL=https://...).
# 3. Make sure ports 80 + 443 are open (provider panel + ufw).
# 4. Recreate gateway + session. Caddy fetches a free Let's Encrypt cert.
#    Join links become https://your-domain/join/CODE?token=... and client
#    screen capture works (browsers require https).
#sk-join.example.com {
#	import common
#}
