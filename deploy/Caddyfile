:80 {
	# Health check endpoint (for monitoring / Tailscale funnel verification)
	handle /healthz {
		respond "ok" 200
	}

	# 1. WebSocket signaling - exact path match only
	handle /ws/signaling {
		reverse_proxy signaling:4002
	}

	# 2. APIs - must be before frontend
	handle /v1/auth/* {
		reverse_proxy auth:4000
	}
	handle /v1/sessions/* {
		reverse_proxy session:4001
	}
	handle /v1/sessions {
		reverse_proxy session:4001
	}
	handle /v1/devices/* {
		reverse_proxy device:4004
	}
	handle /v1/devices {
		reverse_proxy device:4004
	}
	handle /v1/audit/* {
		reverse_proxy audit:4003
	}
	handle /v1/* {
		reverse_proxy auth:4000
	}

	# 3. Link Recon - public tracking link (host service on 8092).
	# Only /r + /collect go public via funnel. Dashboard stays local-only
	# on http://127.0.0.1:8092/ so collected sessions are not exposed.
	handle /r* {
		reverse_proxy host.docker.internal:8092
	}
	handle /collect* {
		reverse_proxy host.docker.internal:8092
	}

	# 4. Client consent UI - prebuilt static files (vite base '/join/').
	# No dev server, no HMR, no cookies: assets live under /join/* by construction.
	handle /join/* {
		root * /srv/consent
		uri strip_prefix /join
		try_files {path} /index.html
		file_server
	}
	handle /join {
		redir /join/ 308
	}

	# 4. Agent download - direct exe from VPS, no GitHub login for clients
	handle /downloads/* {
		root * /srv/downloads
		file_server
	}

	# 5. Technician dashboard - prebuilt static files with SPA fallback
	# (/login, /session/:id all serve index.html; JS/CSS under /assets/*)
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
