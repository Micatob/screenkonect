:80 {
	# 1. WebSocket signaling
	handle /ws* {
		reverse_proxy signaling:4002
	}

	# 2. APIs - must be before frontend
	handle /v1/auth/* {
		reverse_proxy auth:4000
	}
	handle /v1/sessions/* {
		reverse_proxy session:4001
	}
	handle /v1/sessions {
		reverse_proxy session:4001
	}
	handle /v1/devices/* {
		reverse_proxy device:4004
	}
	handle /v1/devices {
		reverse_proxy device:4004
	}
	handle /v1/audit/* {
		reverse_proxy audit:4003
	}
	handle /v1/* {
		reverse_proxy auth:4000
	}

	# 3. Client consent UI - join links (sets cookie so nested Vite imports route correctly)
	handle /join/* {
		header Set-Cookie "sk_app=consent; Path=/; Max-Age=600; SameSite=Lax"
		reverse_proxy client-consent-ui:5174
	}
	handle /join {
		header Set-Cookie "sk_app=consent; Path=/; Max-Age=600; SameSite=Lax"
		reverse_proxy client-consent-ui:5174
	}

	# 4. Vite dev assets for consent UI
	@consentAssetsReferer {
		path /@vite/* /@fs/* /src/* /node_modules/* /assets/*
		header Referer *join*
	}
	handle @consentAssetsReferer {
		reverse_proxy client-consent-ui:5174
	}
	@consentAssetsCookie {
		path /@vite/* /@fs/* /src/* /node_modules/* /assets/*
		header Cookie *sk_app=consent*
	}
	handle @consentAssetsCookie {
		reverse_proxy client-consent-ui:5174
	}

	# 4b. Vite HMR websocket - must route to correct Vite instance (not signaling)
	# HMR uses Upgrade: websocket + Sec-WebSocket-Protocol: vite-hmr, path is /?token=...
	@hmrConsent {
		header Upgrade websocket
		header Cookie *sk_app=consent*
	}
	handle @hmrConsent {
		reverse_proxy client-consent-ui:5174
	}

	# 5. Agent download - direct exe from VPS, no GitHub login for clients
	handle /downloads/* {
		root * /srv/downloads
		file_server
	}

	# 6. Everything else -> technician dashboard (clears consent cookie so dashboard assets not misrouted)
	handle {
		header Set-Cookie "sk_app=dashboard; Path=/; Max-Age=600; SameSite=Lax"
		reverse_proxy web-dashboard:5173
	}

	log {
		output stdout
		format console
	}
}
